    <script src="<?php echo base_url(); ?>public/js/vendor/jquery-3.5.1.min.js"></script>
    <script src="<?php echo base_url(); ?>public/js/vendor/bootstrap.bundle.min.js"></script>
    <script>var url = "<?php echo base_url(); ?>";</script>
    <script src="<?php echo base_url(); ?>phuyu/phuyu_login.js"></script>
    <script>
        (function () {
            const input = document.getElementById('phuyu_clave');
            const btn = document.getElementById('btnTogglePass');
            const capsHelp = document.getElementById('capsLockHelp');
            const form = document.getElementById('form_login');
            const serverMessage = document.getElementById('serverMessage');
            const spinner = document.getElementById('loginSpinner');
            const submitButton = document.getElementById('submitLogin');

            if (btn && input) {
                btn.addEventListener('click', function () {
                    const show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    btn.innerHTML = show
                        ? '<i class="bi bi-eye-slash"></i>'
                        : '<i class="bi bi-eye"></i>';
                });
            }

            if (input && capsHelp) {
                input.addEventListener('keyup', function (event) {
                    const caps = event.getModifierState && event.getModifierState('CapsLock');
                    capsHelp.style.display = caps ? 'inline-block' : 'none';
                });
            }

            if (form) {
                form.addEventListener('submit', function () {
                    serverMessage.style.display = 'none';
                    spinner.style.display = 'inline-flex';
                    submitButton.disabled = true;
                });
            }
        })();
    </script>
</body>
</html>
