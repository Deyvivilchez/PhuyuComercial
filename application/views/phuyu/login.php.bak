                                </div>
                                <small class="text-muted">Ejemplo: usuario o correo registrado</small>
                            </div>

                            <div class="mb-3">
                                <label for="phuyu_clave" class="form-label fw-semibold">Contraseña</label>
                                <div class="input-group input-group-lg custom-group">
                                    <span class="input-group-text bg-white border-end-0">
                                        <i class="bi bi-shield-lock"></i>
                                    </span>
                                    <input
                                        id="phuyu_clave"
                                        type="password"
                                        class="form-control border-start-0 border-end-0"
                                        placeholder="Ingresa tu contraseña"
                                        autocomplete="current-password"
                                        required
                                    />
                                    <button
                                        class="input-group-text bg-white btn-toggle-eye border-start-0"
                                        type="button"
                                        id="btnTogglePass"
                                        aria-label="Mostrar u ocultar contraseña"
                                    >
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <div class="invalid-feedback">Ingresa tu contraseña.</div>
                                </div>
                                <small class="text-warning d-inline-block mt-1" id="capsLockHelp" style="display:none;">Bloq Mayús está activado</small>
                            </div>

                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mt-3 mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="rememberMe" />
                                    <label class="form-check-label text-muted small" for="rememberMe">Recordarme</label>
                                </div>
                                <a href="javascript:void(0);" class="small text-decoration-none forgot-link">¿Olvidaste tu contraseña?</a>
