Solución 1: mantener serie B001 pero renumerar desde 30

BEGIN;

CREATE TEMP TABLE tmp_boletas_b001 AS
SELECT
    k.codkardex,
    k.nrocomprobante AS nro_anterior,
    lpad((nullif(regexp_replace(k.nrocomprobante, '\D', '', 'g'), '')::int + 29)::text, 8, '0') AS nro_nuevo,
    ks.nombre_xml AS xml_anterior,
    regexp_replace(
        ks.nombre_xml,
        '-03-B001-[0-9]+$',
        '-03-B001-' || lpad((nullif(regexp_replace(k.nrocomprobante, '\D', '', 'g'), '')::int + 29)::text, 8, '0')
    ) AS xml_nuevo
FROM kardex.kardex k
LEFT JOIN sunat.kardexsunat ks ON ks.codkardex = k.codkardex
WHERE k.codcomprobantetipo = 12
  AND k.seriecomprobante = 'B001';

-- XML individual de cada boleta
UPDATE sunat.kardexsunat ks
SET nombre_xml = t.xml_nuevo
FROM tmp_boletas_b001 t
WHERE ks.codkardex = t.codkardex
  AND t.xml_nuevo IS NOT NULL;

-- Venta / kardex principal
UPDATE kardex.kardex k
SET nrocomprobante = t.nro_nuevo
FROM tmp_boletas_b001 t
WHERE k.codkardex = t.codkardex;

-- Referencias en movimientos de caja
UPDATE caja.movimientos m
SET nrocomprobante_ref = t.nro_nuevo
FROM tmp_boletas_b001 t
WHERE m.codcomprobantetipo_ref = 12
  AND m.seriecomprobante_ref = 'B001'
  AND m.nrocomprobante_ref = t.nro_anterior;

-- Referencias en notas, por si existieran
UPDATE kardex.kardex k
SET nrocomprobante_ref = t.nro_nuevo
FROM tmp_boletas_b001 t
WHERE k.codcomprobantetipo_ref = 12
  AND k.seriecomprobante_ref = 'B001'
  AND k.nrocomprobante_ref = t.nro_anterior;

-- Otras tablas relacionadas, inofensivo si no tienen datos
UPDATE kardex.creditos c
SET nrocomprobante = t.nro_nuevo
FROM tmp_boletas_b001 t
WHERE c.codcomprobantetipo = 12
  AND c.seriecomprobante = 'B001'
  AND c.nrocomprobante = t.nro_anterior;

UPDATE kardex.cuotaspagos c
SET nrocomprobante = t.nro_nuevo
FROM tmp_boletas_b001 t
WHERE c.codcomprobantetipo = 12
  AND c.seriecomprobante = 'B001'
  AND c.nrocomprobante = t.nro_anterior;

-- Dejar el correlativo listo para la siguiente boleta: 64
UPDATE caja.comprobantes
SET nroinicial = 30,
    nrocorrelativo = (
        SELECT max(nullif(regexp_replace(nro_nuevo, '\D', '', 'g'), '')::int)
        FROM tmp_boletas_b001
    )
WHERE codcomprobantetipo = 12
  AND seriecomprobante = 'B001'
  AND estado = 1;

COMMIT;



